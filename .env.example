# Public build configuration only. Never put user credentials here. Copy to .env (git-ignored).

# Google OAuth 2.0 client of type "Desktop app" (enables "Continue with Google" in desktop builds).
# Google's installed-app model treats the client secret as public; it is NOT a security boundary.
VITE_GOOGLE_OAUTH_CLIENT_ID_DESKTOP=
VITE_GOOGLE_OAUTH_CLIENT_SECRET_DESKTOP=

# Expose the Mock provider in production builds (always available in dev).
VITE_ENABLE_MOCK_PROVIDER=false

VITE_APP_VERSION=0.1.0

# --- Server stack (docker compose reads this .env too). Secrets do NOT go here: they are files in ./secrets
# --- (created by `node scripts/dev-secrets.mjs`, real values written by hand in production).
# Public URL of the site; https in production.
# PUBLIC_ORIGIN=https://app.example.com
# Public host Caddy serves with automatic HTTPS (plain HTTP on :80 when unset).
# CADDY_SITE=app.example.com
# MAIL_FROM=AI Image Variations <no-reply@example.com>
# GOOGLE_CLIENT_ID=
# LOG_LEVEL=info
