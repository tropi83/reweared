# Public build configuration only. Never put user credentials here. Copy to .env (git-ignored).

VITE_APP_VERSION=0.1.0

# The API the app works with: "/" (default) for the web bundle and `pnpm dev` (Vite proxies /api to the dev stack);
# for the desktop and phone apps, the public https origin (https://app.example.com), or http://localhost:8080 for the
# dev stack — `pnpm tauri dev|build` refuses to run without it.
# VITE_API_ORIGIN=/

# --- Server stack (docker compose reads this .env too). Secrets do NOT go here: they are files in ./secrets
# --- (created by `node scripts/dev-secrets.mjs`, real values written by hand in production).
# Public URL of the site; https in production.
# PUBLIC_ORIGIN=https://app.example.com
# Public host Caddy serves with automatic HTTPS (plain HTTP on :80 when unset).
# CADDY_SITE=app.example.com
# MAIL_FROM=AI Image Variations <no-reply@example.com>
# GOOGLE_CLIENT_ID=
# LOG_LEVEL=info

# --- Backups (OPERATIONS.md → Backups and restore). Credentials are secret files in ./secrets, not variables.
# BACKUP_TARGET=offsite:aiv-backups
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.com
# RCLONE_CONFIG_OFFSITE_REGION=eu
# BACKUP_AGE_RECIPIENT=age1...        # public key only; the private key stays offline
# BACKUP_PING_URL=                    # optional dead-man's switch; receives pings, never data
# AIV_VERSION=0.1.0                   # the released version compose.yaml runs
