{
  "name": "@aiv/server",
  "version": "0.1.0",
  "private": true,
  "description": "AI Image Variations server: REST API (accounts, listings, images) and, from phase 2, the generation worker.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx watch src/api.ts",
    "typecheck": "tsc -p tsconfig.json",
    "auth:schema": "auth generate --config scripts/auth-schema.config.ts --adapter drizzle --dialect postgresql --output src/db/auth-schema.ts -y && prettier --write src/db/auth-schema.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aiv/contracts": "workspace:*",
    "@aiv/domain": "workspace:*",
    "@aws-sdk/client-s3": "3.1149.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "resend": "6.32.1",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
